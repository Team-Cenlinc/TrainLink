{
  "name": "trainlink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "NODE_OPTIONS=--experimental-strip-types prettier --write .",
    "format:check": "NODE_OPTIONS=--experimental-strip-types prettier --check .",
    "icons": "NODE_OPTIONS=--experimental-strip-types node scripts/build-icons.ts"
  },
  "dependencies": {
    "@material-symbols/svg-400": "^0.48.2",
    "@tanstack/query-async-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5"
  }
}
